# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---- 构建产物：全部收在 build/ 一个目录里 ----
#     build/
#     ├── tongyi-players.zip       ← 唯一交付物
#     ├── tongyi-launch.exe        ← 桥（Steam 启动选项 / 排查用）
#     ├── tongyi-pak01_dir.vpk     ← mod 包（DMM 导入这个文件）
#     └── .work/                   ← 中间产物（PyInstaller、mod 编译暂存、打包暂存）
# 整条链重建：
#   python scripts\stage_compile.py --pack           → build\tongyi-pak01_dir.vpk
#   python -m PyInstaller --clean --noconfirm --distpath build/.work --workpath build/.work/pyinstaller packaging\bridge.spec
#   packaging\package_player_zip.bat                 → build\tongyi-players.zip
# 磁盘不够时 `rm -rf build` 即可，什么都不影响。
build/
# 历史目录名（2026-09-20 收敛前用过），留着忽略以免老工作区又被跟踪进来
build_pkgs/
build_mod/
dist/
dist_mod/
*.spec.bak

# ---- 运行期产物（日志、抓帧调试输出）----
# spike_out/ 是桌面版（OCR 校准）时代留下的目录名，老用户的 %APPDATA%\deadlock-fanyi\
# 里可能还有，迁移逻辑照搬不误，所以这里继续忽略。
spike_out/
logs/
*.log
config.local.yaml
# 英→中 benchmark 的"上一次结果"：每跑一次就覆盖，属于本机产物（scripts/bench_en2zh.py 写）
data/bench_en2zh_last.json

# ---- 第三方专有二进制：不放仓库 ----
# tools/ 装的是 Valve 的 CSDK 12 工具链（resourcecompiler）和 Source2Viewer。
# 它们是 Valve 的版权文件、且 Source2Viewer-CLI.exe 单个就有 ~108 MB，
# 超过 GitHub 单文件 100 MB 的硬限制，推上去必然失败。
# 需要重新编译 mod 的人按 docs/mod-build.md 自己准备：
#   tools/rc/resourcecompiler.exe + resourcecompiler.dll + tier0.dll ...  ← CSDK 12 的 game\bin_cs2\win64\
#   tools/vrf/Source2Viewer-CLI.exe                                       ← https://github.com/ValveResourceFormat/ValveResourceFormat
tools/

# ---- 编辑器 ----
.idea/*
!.idea/.gitignore
!.idea/profiles_settings.xml
!.idea/modules.xml
!.idea/*.iml
